#!/usr/bin/env bash
# Flat Cherry Selective Firmware (FCSF)
# Selects firmware already present in the Live ISO; no network access is used.
set -euo pipefail

VERSION="0.1.0"
SOURCE_ROOT="${FCSF_SOURCE_ROOT:-/}"
TARGET_ROOT="${FCSF_TARGET_ROOT:-/mnt}"
FIRMWARE_DIR="${FCSF_FIRMWARE_DIR:-$SOURCE_ROOT/usr/lib/firmware}"
CPU_DIR="${FCSF_CPU_DIR:-$SOURCE_ROOT/usr/lib/firmware}"
STATE_DIR="${FCSF_STATE_DIR:-$TARGET_ROOT/var/lib/flatcherry/fcsf}"
REPORT_DIR="${FCSF_REPORT_DIR:-$TARGET_ROOT/var/log/flatcherry}"
MODE="${1:-menu}"

declare -A FOUND=()
declare -A SELECTED=()

usage() {
  cat <<'EOF'
Usage: fcsf [menu|smart|generic|manual|detect|--help]

Modes:
  menu     Show the interactive mode selector (default)
  smart    Detect local hardware and select matching vendor firmware
  generic  Keep the complete firmware collection
  manual   Let the user choose firmware vendors
  detect   Print detected hardware vendors without changing files

For installation-time use, set FCSF_SOURCE_ROOT to the Live ISO root and
FCSF_TARGET_ROOT to the installed system's mounted root.
EOF
}

need_root() {
  if [[ $EUID -ne 0 ]]; then
    echo "FCSF: run as root to apply firmware to the target system." >&2
    exit 1
  fi
}

detect_hardware() {
  local f vendor class
  # PCI vendor IDs. Class 0x02 identifies network controllers.
  if [[ -d /sys/bus/pci/devices ]]; then
    for f in /sys/bus/pci/devices/*; do
      [[ -r "$f/vendor" ]] || continue
      vendor=$(<"$f/vendor")
      class="000000"
      [[ -r "$f/class" ]] && class=$(<"$f/class")
      case "$vendor" in
        0x1002) FOUND[amd]=1 ;;
        0x10de) FOUND[nvidia]=1 ;;
        0x8086) FOUND[intel]=1 ;;
        0x14e4) FOUND[broadcom]=1 ;;
        0x10ec) FOUND[realtek]=1 ;;
        0x14c3|0x037a) FOUND[mediatek]=1 ;;
        0x168c|0x17cb) FOUND[qualcomm]=1 ;;
      esac
      if [[ "$class" == 0x02* ]]; then
        case "$vendor" in
          0x1002) FOUND[network-amd]=1 ;;
          0x8086) FOUND[network-intel]=1 ;;
          0x14e4) FOUND[network-broadcom]=1 ;;
          0x10ec) FOUND[network-realtek]=1 ;;
          0x14c3|0x037a) FOUND[network-mediatek]=1 ;;
          0x168c|0x17cb) FOUND[network-qualcomm]=1 ;;
        esac
      fi
    done
  fi

  # USB vendor IDs (useful for USB Wi-Fi and Bluetooth adapters).
  if [[ -d /sys/bus/usb/devices ]]; then
    for f in /sys/bus/usb/devices/*; do
      [[ -r "$f/idVendor" ]] || continue
      vendor=$(<"$f/idVendor")
      case "$vendor" in
        0x0bda|0bda) FOUND[realtek]=1; FOUND[network-realtek]=1 ;;
        0x0a5c|05ac) FOUND[broadcom]=1; FOUND[network-broadcom]=1 ;;
        0x0e8d|0e8d) FOUND[mediatek]=1; FOUND[network-mediatek]=1 ;;
        0x8087|8087) FOUND[intel]=1; FOUND[network-intel]=1 ;;
        0x0cf3|0cf3) FOUND[qualcomm]=1; FOUND[network-qualcomm]=1 ;;
      esac
    done
  fi

  # CPU vendor is independent from PCI/USB firmware selection.
  if [[ -r /proc/cpuinfo ]]; then
    if grep -qim1 'vendor_id[[:space:]]*:[[:space:]]*AuthenticAMD' /proc/cpuinfo; then
      FOUND[cpu-amd]=1
    fi
    if grep -qim1 'vendor_id[[:space:]]*:[[:space:]]*GenuineIntel' /proc/cpuinfo; then
      FOUND[cpu-intel]=1
    fi
  fi
}

show_detection() {
  echo "FCSF $VERSION — detected hardware"
  local key
  for key in cpu-amd cpu-intel amd intel nvidia broadcom realtek mediatek qualcomm; do
    if [[ ${FOUND[$key]+yes} ]]; then printf '  [detected] %s\n' "$key"; fi
  done
  for key in network-amd network-intel network-broadcom network-realtek network-mediatek network-qualcomm; do
    if [[ ${FOUND[$key]+yes} ]]; then printf '  [network]  %s\n' "$key"; fi
  done
}

select_smart() {
  local key
  for key in "${!FOUND[@]}"; do SELECTED["$key"]=1; done
}

select_manual() {
  local key answer
  echo "Choose firmware vendors (y/N):"
  for key in amd intel nvidia broadcom realtek mediatek qualcomm; do
    read -r -p "  Include $key? " answer
    [[ "$answer" =~ ^[Yy]$ ]] && SELECTED["$key"]=1
  done
  for key in cpu-amd cpu-intel; do
    [[ ${FOUND[$key]+yes} ]] && SELECTED["$key"]=1
  done
}

# Vendor directories are copied only when present in the ISO's firmware tree.
# Keep this map conservative; unmatched firmware remains available in the ISO.
vendor_paths() {
  case "$1" in
    amd)       printf '%s\n' 'amd*' amdgpu radeon ;;
    intel)     printf '%s\n' i915 xe 'iwlwifi*' 'intel*' 'e100*' ;;
    nvidia)    printf '%s\n' nvidia ;;
    broadcom)  printf '%s\n' brcm ;;
    realtek)   printf '%s\n' 'rtl*' 'rtw*' ;;
    mediatek)  printf '%s\n' 'mt7*.bin*' mediatek ;;
    qualcomm)  printf '%s\n' qca 'ath*' 'ar*' 'wil6210*' ;;
  esac
}

apply_selection() {
  need_root
  [[ -d "$FIRMWARE_DIR" ]] || {
    echo "FCSF: firmware source not found: $FIRMWARE_DIR" >&2
    exit 1
  }
  mkdir -p "$STATE_DIR" "$REPORT_DIR" "$TARGET_ROOT/usr/lib/firmware"
  local report="$REPORT_DIR/fcsf-report.txt"
  : > "$report"
  echo "FCSF $VERSION mode=$MODE" | tee -a "$report"

  if [[ "$MODE" == generic ]]; then
    cp -a "$FIRMWARE_DIR/." "$TARGET_ROOT/usr/lib/firmware/"
    echo "Generic mode: copied the complete offline firmware collection." | tee -a "$report"
    return 0
  fi

  local vendor path item copied=0
  for vendor in amd intel nvidia broadcom realtek mediatek qualcomm; do
    [[ ${SELECTED[$vendor]+yes} ]] || continue
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      local -a matches=()
      shopt -s nullglob
      matches=( "$FIRMWARE_DIR"/$path )
      shopt -u nullglob
      for item in "${matches[@]}"; do
        [[ -e "$item" ]] || continue
        cp -a "$item" "$TARGET_ROOT/usr/lib/firmware/"
        printf 'included vendor=%s path=%s\n' "$vendor" "${item#"$FIRMWARE_DIR"/}" | tee -a "$report"
        copied=$((copied + 1))
      done
    done < <(vendor_paths "$vendor")
  done

  # Microcode packages are handled as separate CPU-specific payloads.
  if [[ ${SELECTED[cpu-amd]+yes} && -d "$CPU_DIR/amd-ucode" ]]; then
    cp -a "$CPU_DIR/amd-ucode" "$TARGET_ROOT/usr/lib/firmware/"
    echo "included cpu-microcode=amd" | tee -a "$report"
  fi
  if [[ ${SELECTED[cpu-intel]+yes} && -d "$CPU_DIR/intel-ucode" ]]; then
    cp -a "$CPU_DIR/intel-ucode" "$TARGET_ROOT/usr/lib/firmware/"
    echo "included cpu-microcode=intel" | tee -a "$report"
  fi

  printf 'vendor_paths_copied=%s\n' "$copied" | tee -a "$report"
  echo "NOTE: FCSF does not remove the Live ISO firmware; it stages selected payloads on the target." | tee -a "$report"
}

case "$MODE" in
  --help|-h) usage; exit 0 ;;
  detect)
    detect_hardware
    show_detection
    exit 0
    ;;
  menu)
    echo "Flat Cherry Firmware Setup"
    echo "1) Smart — detect this computer"
    echo "2) Generic — keep all firmware"
    echo "3) Manual — choose vendors"
    read -r -p "Select [1-3]: " choice
    case "$choice" in
      1) MODE=smart ;;
      2) MODE=generic ;;
      3) MODE=manual ;;
      *) echo "Invalid selection." >&2; exit 2 ;;
    esac
    ;;
  smart|generic|manual) ;;
  *) usage >&2; exit 2 ;;
esac

if [[ "$MODE" == smart || "$MODE" == manual ]]; then
  detect_hardware
  show_detection
fi

case "$MODE" in
  smart) select_smart ;;
  manual) select_manual ;;
  generic) ;;
esac

apply_selection
