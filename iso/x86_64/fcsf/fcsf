#!/usr/bin/env bash
# Flat Cherry Selective Firmware (FCSF)
# Network firmware is bundled in the Live ISO; additional firmware is installed
# into the target system from the configured Void XBPS repositories.
set -euo pipefail

VERSION="0.2.0"
TARGET_ROOT="${FCSF_TARGET_ROOT:-/mnt}"
MODE="${1:-menu}"

declare -A FOUND=()
declare -A SELECTED=()

usage() {
  cat <<'EOF'
Usage: fcsf [menu|smart|generic|manual|detect|--help]

Modes:
  menu     Show the interactive mode selector (default)
  smart    Detect hardware; keep network firmware and fetch matching GPU/CPU firmware
  generic  Fetch all supported firmware categories
  manual   Let the user choose additional firmware categories
  detect   Print detected hardware categories without changing files

Network firmware is included in the Live ISO. Additional firmware requires internet.
Set FCSF_TARGET_ROOT to the installed system root (default: /mnt).
EOF
}

need_root() {
  if [[ $EUID -ne 0 ]]; then
    echo "FCSF: run as root to install firmware into the target system." >&2
    exit 1
  fi
}

detect_hardware() {
  local f vendor class
  if [[ -d /sys/bus/pci/devices ]]; then
    for f in /sys/bus/pci/devices/*; do
      [[ -r "$f/vendor" ]] || continue
      vendor=$(<"$f/vendor")
      class="000000"
      [[ -r "$f/class" ]] && class=$(<"$f/class")
      # Only graphics-class PCI devices select GPU firmware.
      if [[ "$class" == 0x03* ]]; then
        case "$vendor" in
          0x1002) FOUND[amd]=1 ;;
          0x10de) FOUND[nvidia]=1 ;;
          0x8086) FOUND[intel]=1 ;;
        esac
      fi
    done
  fi

  # CPU microcode is independent of PCI graphics hardware.
  if [[ -r /proc/cpuinfo ]]; then
    grep -qim1 'vendor_id[[:space:]]*:[[:space:]]*AuthenticAMD' /proc/cpuinfo && FOUND[cpu-amd]=1 || true
    grep -qim1 'vendor_id[[:space:]]*:[[:space:]]*GenuineIntel' /proc/cpuinfo && FOUND[cpu-intel]=1 || true
  fi
}

show_detection() {
  echo "FCSF $VERSION — detected firmware categories"
  local key
  for key in amd intel nvidia cpu-amd cpu-intel; do
    [[ ${FOUND[$key]+yes} ]] && printf '  [detected] %s\n' "$key"
  done
  echo "  [bundled]  network (Wi-Fi/Ethernet firmware)"
}

select_smart() {
  local key
  for key in amd intel nvidia; do
    [[ ${FOUND[$key]+yes} ]] && SELECTED["$key"]=1
  done
  [[ ${FOUND[cpu-amd]+yes} ]] && SELECTED[amd]=1
}

select_manual() {
  local key answer
  echo "Choose additional firmware categories (y/N):"
  for key in amd intel nvidia; do
    read -r -p "  Include $key firmware? " answer
    [[ "$answer" =~ ^[Yy]$ ]] && SELECTED["$key"]=1
  done
}

install_selection() {
  need_root
  [[ -d "$TARGET_ROOT" ]] || {
    echo "FCSF: target root does not exist: $TARGET_ROOT" >&2
    exit 1
  }
  command -v xbps-install >/dev/null 2>&1 || {
    echo "FCSF: xbps-install is unavailable in the Live environment." >&2
    exit 1
  }
  [[ -d "$TARGET_ROOT/var/db/xbps" ]] || {
    echo "FCSF: target does not look like an initialized Void system (missing /var/db/xbps)." >&2
    exit 1
  }

  local -a packages=(linux-firmware-network)
  if [[ "$MODE" == generic ]]; then
    packages+=(linux-firmware-amd linux-firmware-intel linux-firmware-nvidia)
  else
    [[ ${SELECTED[amd]+yes} ]] && packages+=(linux-firmware-amd)
    [[ ${SELECTED[intel]+yes} ]] && packages+=(linux-firmware-intel)
    [[ ${SELECTED[nvidia]+yes} ]] && packages+=(linux-firmware-nvidia)
  fi

  # Remove duplicates while preserving order.
  local -A seen=()
  local -a unique=()
  local pkg
  for pkg in "${packages[@]}"; do
    [[ ${seen[$pkg]+yes} ]] && continue
    seen[$pkg]=1
    unique+=("$pkg")
  done

  echo "FCSF: installing firmware packages into $TARGET_ROOT"
  printf '  %s\n' "${unique[@]}"
  echo "FCSF: internet access is required for any package not already available locally."
  xbps-install -r "$TARGET_ROOT" -Sy "${unique[@]}"

  mkdir -p "$TARGET_ROOT/var/log/flatcherry"
  {
    echo "FCSF $VERSION mode=$MODE"
    printf 'installed_package=%s\n' "${unique[@]}"
    echo "network_firmware=linux-firmware-network (always selected)"
  } | tee "$TARGET_ROOT/var/log/flatcherry/fcsf-report.txt"
}

case "$MODE" in
  --help|-h) usage; exit 0 ;;
  detect)
    detect_hardware
    show_detection
    exit 0
    ;;
  menu)
    echo "Flat Cherry Firmware Setup"
    echo "1) Smart Online — detect this computer"
    echo "2) Generic Online — install all supported firmware"
    echo "3) Manual Online — choose firmware categories"
    read -r -p "Select [1-3]: " choice
    case "$choice" in
      1) MODE=smart ;;
      2) MODE=generic ;;
      3) MODE=manual ;;
      *) echo "Invalid selection." >&2; exit 2 ;;
    esac
    ;;
  smart|generic|manual) ;;
  *) usage >&2; exit 2 ;;
esac

if [[ "$MODE" == smart || "$MODE" == manual ]]; then
  detect_hardware
  show_detection
fi

case "$MODE" in
  smart) select_smart ;;
  manual) select_manual ;;
  generic) ;;
esac

install_selection
